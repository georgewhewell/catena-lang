# Ordinary Hex instantiations of the shared numeric operations.
(theory type nat { (arr testnumeric.left : 0 -> 1) (arr testnumeric.right : 0 -> 1) (arr testnumeric.value : 0 -> 1) })
(theory program type {
(arr meta.testnumeric.sqrt-proof : {1} -> {1 ({bf16 testnumeric.value} stdlib.numeric.prop.Nonnegative)})
(arr meta.testnumeric.rsqrt-proof : {1} -> {1 ({bf16 testnumeric.value} stdlib.numeric.prop.Positive)})
 (arr meta.testnumeric.left : 1 -> testnumeric.left) (arr meta.testnumeric.right : 1 -> testnumeric.right) (arr meta.testnumeric.value : 1 -> testnumeric.value) })
(def program stdlib.test.numeric.add : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.+ :.forget)))
(def program stdlib.test.numeric.sub : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.- :.forget)))
(def program stdlib.test.numeric.mul : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.* :.forget)))
(def program stdlib.test.numeric.div : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric./ :.forget)))
(def program stdlib.test.numeric.neg : (bf16 val) -> (bf16 val) = ([a.] ([.] stdlib.numeric.signed.bf16 [e.]) ([.] unit.intro meta.testnumeric.value [id.]) ([.a id] smolcat.value.named_at [x.]) ([.x e] stdlib.numeric.negate :.forget)))
(def program stdlib.test.numeric.eq : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.equal *.elim [value proof.]) ([.proof] unsafe.discard unit.elim) ([.value] :.forget)))
(def program stdlib.test.numeric.ne : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.a b e] stdlib.numeric.not_equal)))
(def program stdlib.test.numeric.lt : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.a b e] stdlib.numeric.less)))
(def program stdlib.test.numeric.lte : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.a b e] stdlib.numeric.less_equal)))
(def program stdlib.test.numeric.gt : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.greater *.elim [value proof.]) ([.proof] unsafe.discard unit.elim) ([.value] :.forget)))
(def program stdlib.test.numeric.gte : {(bf16 val) (bf16 val)} -> (bool val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.a b e] stdlib.numeric.greater_equal)))
(def program stdlib.test.numeric.min : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.min :.forget)))
(def program stdlib.test.numeric.max : {(bf16 val) (bf16 val)} -> (bf16 val) = ([a b.] ([.] stdlib.numeric.numeric.bf16 [e.]) ([.] unit.intro meta.testnumeric.left [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro meta.testnumeric.right [rid.]) ([.b rid] smolcat.value.named_at [y.]) ([.x y e] stdlib.numeric.max :.forget)))
(def program stdlib.test.numeric.exp : (bf16 val) -> (bf16 val) = ([a.] ([.] stdlib.numeric.floating.bf16 [e.]) ([.] unit.intro meta.testnumeric.value [id.]) ([.a id] smolcat.value.named_at [x.]) ([.x e] stdlib.numeric.exp :.forget)))
(def program stdlib.test.numeric.sqrt : (bf16 val) -> (bf16 val) = ([a.] ([.] stdlib.numeric.floating.bf16 [e.]) ([.] unit.intro meta.testnumeric.value [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro [u.]) ([.u] (meta.testnumeric.sqrt-proof {{_} (name.unsafe.assume lift)} evaluate {_}) [p.]) ([.x p e] stdlib.numeric.sqrt :.forget)))
(def program stdlib.test.numeric.rsqrt : (bf16 val) -> (bf16 val) = ([a.] ([.] stdlib.numeric.floating.bf16 [e.]) ([.] unit.intro meta.testnumeric.value [id.]) ([.a id] smolcat.value.named_at [x.]) ([.] unit.intro [u.]) ([.u] (meta.testnumeric.rsqrt-proof {{_} (name.unsafe.assume lift)} evaluate {_}) [p.]) ([.x p e] stdlib.numeric.rsqrt :.forget)))
